#ifndef SECRETS_H
#define SECRETS_H
// 이 파일을 secrets.h 로 복사한 뒤 값을 채우세요.
// ★ secrets.h 는 저장소에 올리지 마세요. 소유자가 대시보드에서 비밀번호를 "재발급"하면 다시 구워야 합니다.

// ── Wi-Fi (2.4GHz만) ──
#define WIFI_SSID     "여기에_공유기_이름"
#define WIFI_PASSWORD "여기에_공유기_비밀번호"

// ── 젯슨 서버 (MQTT 8443 · HTTPS 443 같은 주소, 같은 계정) ──
// ★ 아래 두 값은 대시보드 → 장치 연결 → 브로커 계정 에서 받아 채웁니다.
#define MQTT_HOST     "helphyai-jetson.tail3126a6.ts.net"
#define MQTT_PORT     8443
#define MQTT_USER     "여기에_인스턴스ID"        // 예: jetson-01
#define MQTT_PASS     "여기에_인스턴스_비밀번호"

// ── 디바이스 식별 ──
#define DEVICE_NAME     "helpai.cube"
#define DEVICE_VENDOR   "HelpAI"
#define DEVICE_MODEL    "CAM-V1"
#define DEVICE_SN       "CUBE001-C1"           // <큐브 SN>-C<번호 1~99>. 큐브는 위 계정 소유여야 함
#define DEVICE_PASSKEY  "unused"

// ── LAN 원격 업로드(ArduinoOTA) 비밀번호 (2026-10-02, 사용자 결정: 큐브 제어기와 같은 값) ──
// 아두이노 IDE 네트워크 포트 업로드 때 묻는 값. 벤치용. 현장 보드는 config.h ENABLE_LAN_OTA=0 으로 빌드.
// 자리표시자가 남아 있으면 원격 업로드를 켜지 않습니다.
#define OTA_PASSWORD  "여기에_OTA_비밀번호"

#endif
