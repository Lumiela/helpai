/*
 * secrets.h.example — 자격증명 템플릿 (병합본, 2026-09-22)
 * ------------------------------------------------------------------
 * 이 파일을 secrets.h 로 복사한 뒤 실제 값을 채우세요.
 *
 *   copy secrets.h.example secrets.h      (Windows)
 *   cp   secrets.h.example secrets.h      (macOS/Linux)
 *
 * ★ secrets.h 는 절대 Git 에 올리지 마세요(.gitignore 가 막습니다).
 *   Wi-Fi 비밀번호와 브로커 계정 비밀번호가 들어갑니다.
 *
 * 브로커: 젯슨 mosquitto. 인터넷에서는 Tailscale Funnel 이 TLS 를 풀어 8443 → 1883 로
 * 넘깁니다. 루트 인증서는 certs.h(공개 정보)에 있어 따로 채울 것이 없습니다.
 * 익명 접속은 막혀 있으므로 MQTT_USER / MQTT_PASS 를 반드시 채워야 합니다.
 */

#ifndef SECRETS_H
#define SECRETS_H

// ── Wi-Fi ────────────────────────────────────────────────────────
// ESP32 는 2.4GHz 만 됩니다. 아이디·비밀번호로 로그인하는 기업용 Wi-Fi(WPA2-Enterprise)는 안 됩니다.
#define WIFI_SSID     "여기에_공유기_이름"
#define WIFI_PASSWORD "여기에_공유기_비밀번호"

// ── 젯슨 브로커 ──────────────────────────────────────────────────
// 이름(MagicDNS)을 씁니다. 주소를 박으면 서버가 옮겨갈 때 다시 구워야 합니다.
#define MQTT_HOST     "helphyai-jetson.tail3126a6.ts.net"
#define MQTT_PORT     8443             // Funnel TLS 종단. 도메인 있는 일반 서버는 8883
#define MQTT_USER     "cube001"        // 장치 전용 계정 (젯슨 /data/.env 의 CUBE001_PASSWORD)
#define MQTT_PASS     "여기에_브로커_비밀번호"

// ── 디바이스 식별 ─────────────────────────────────────────────────
// DEVICE_NAME = 토픽의 앱 이름: device/<DEVICE_NAME>/<DEVICE_SN>/…
// 젯슨 bridge·api 의 AG_APP 환경변수와 같아야 합니다(2026-09-22 결정: helpai.cube).
// DEVICE_SN 은 큐브마다 고유해야 합니다. 대시보드·InfluxDB 태그가 이 값으로 구성됩니다.
#define DEVICE_NAME     "helpai.cube"
#define DEVICE_VENDOR   "HelpAI"
#define DEVICE_MODEL    "CUBE-V1"
#define DEVICE_SN       "CUBE001"
// 아래는 AGEdgeConnector(PNP) 전용이라 병합본에서는 쓰지 않습니다. 호환용으로만 둡니다.
#define DEVICE_PASSKEY  "unused"

// ── LAN 원격 업로드(ArduinoOTA) 비밀번호 (2026-09-30 추가, 사용자 결정: 큐브 공통) ──
// 같은 Wi-Fi 에서 아두이노 IDE 네트워크 포트로 올릴 때 묻는 값. 자리표시자가 남아 있으면 OTA 를 켜지 않습니다.
// 벤치용입니다. 현장 큐브는 config.h 의 ENABLE_LAN_OTA=0 으로 빌드합니다.
#define OTA_PASSWORD  "여기에_OTA_비밀번호"

#endif  // SECRETS_H
